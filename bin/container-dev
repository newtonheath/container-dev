#!/usr/bin/env bash
set -euo pipefail

# Container-dev main command wrapper
# Dispatches to subcommands in bin/

# Resolve symlink to find actual script location
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ $SCRIPT_PATH != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

usage() {
  cat <<EOF
container-dev - Manage containerized development environments

Usage: container-dev <command> [args]

Commands:
  create <profile> [--persistent]  Create a container (or resume a stopped one)
  delete <container-name>          Permanently remove a container
  list                             List all containers (running and stopped)

Profiles:
  claude           Claude Code (auth auto-detected)
  opencode         Opencode with Claude backend
  opencode-local   Opencode with local llama.cpp
  pi               Pi with Claude backend
  pi-local         Pi with local llama.cpp

Examples:
  # Create transient container
  cd ~/my-project
  container-dev create claude
  ssh claude-transient

  # Create persistent container
  cd ~/important-work
  container-dev create claude --persistent
  ssh claude-importantwork

  # Pause/resume (native container commands, preserves state)
  container stop claude-transient
  container start claude-transient

  # List all containers
  container-dev list

  # Permanently delete a container
  container-dev delete claude-transient

For more information, see: https://github.com/your-repo/container-dev
EOF
}

if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

COMMAND="$1"
shift

case "$COMMAND" in
  create)
    exec "$SCRIPT_DIR/create.sh" "$@"
    ;;
  delete|rm)
    exec "$SCRIPT_DIR/delete.sh" "$@"
    ;;
  list|ls)
    exec "$SCRIPT_DIR/list.sh" "$@"
    ;;
  help|--help|-h)
    usage
    exit 0
    ;;
  *)
    echo "Error: Unknown command '$COMMAND'"
    echo ""
    usage
    exit 1
    ;;
esac
